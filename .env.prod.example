# ================================================
# Digital Security Logbook - Production Environment
# ================================================
#
# PENTING:
# - Copy file ini ke .env di root project untuk docker-compose.prod.yml.
# - Jangan commit file .env yang berisi secret.
# - Gunakan value production yang aman.

# Database
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=digital_logbook

# JWT
JWT_SECRET=your-super-long-random-jwt-secret-minimum-32-characters

# Public URLs
FRONTEND_URL=https://pe.spil.co.id/dsl
BACKEND_PUBLIC_URL=https://pe.spil.co.id/dsl-api
NEXT_PUBLIC_API_ENDPOINT=https://pe.spil.co.id/dsl-api
NEXT_PUBLIC_BASE_PATH=/dsl

# App
APP_TIMEZONE=Asia/Jakarta
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE=5242880
