# ====================================
# TDS Backend Environment Variables
# ====================================

# Application
ENV=development
WEB_PORT=8080
GIN_MODE=debug

# Database (for local non-docker development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spil
DB_PASS=spil
DB_NAME=digital_logbook
ENABLE_CRON=false

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# SSO Integration
SSO_BASE_URL=http://host.docker.internal:5000
SSO_FRONTEND_URL=http://localhost:5173
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:8080/api/auth/sso/callback
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# LLM / Groq API (if using)
GROQ_API_KEY=your-groq-api-key-here

# File Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=storage/uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
