# ====================================
# TDS Backend Environment Variables
# ====================================

# Application
ENV=development
WEB_PORT=8080
GIN_MODE=debug

# Database (for local non-docker development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spil
DB_PASS=spil
DB_NAME=digital_logbook
ENABLE_CRON=false

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# File Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=storage/uploads

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
